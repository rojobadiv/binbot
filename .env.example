# ── core ──────────────────────────────────────────────
BOT_TOKEN=123456:ABC-DEF...
ADMIN_IDS=111111111

# true  = anyone can use the bot
# false = new users need admin approval (secured mode)
FREE_MODE=false
NOTIFY_ADMIN_ON_JOIN=true

# ── checking ──────────────────────────────────────────
MAX_BINS_PER_JOB=5000
DEFAULT_CONCURRENCY=25
MAX_CONCURRENCY=80
REQUEST_TIMEOUT=12
MAX_JOBS_PER_USER=1
PROGRESS_INTERVAL=2.5
CACHE_TTL_HOURS=24
ONLY_LIVE_IN_RESULT=true

# ── providers ─────────────────────────────────────────
CUSTOM_BIN_URL=
CUSTOM_BIN_HEADERS=

# ── proxies ───────────────────────────────────────────
GLOBAL_PROXIES=
ADMIN_ONLY_PROXIES=true

# ── storage / branding ────────────────────────────────
DB_PATH=binbot.sqlite3
BOT_NAME=BIN SENTINEL
SUPPORT_HANDLE=